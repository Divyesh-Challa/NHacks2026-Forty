{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["backend/.venv", "signal/.venv", "frontend/node_modules"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pr_gate.sh",
            "timeout": 300,
            "statusMessage": "Running gates before opening the PR…"
          }
        ]
      }
    ]
  }
}
